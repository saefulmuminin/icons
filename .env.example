# Absolute address the site is served from. Drives canonical links, hreflang
# alternates and the share card. Baked in at build time.
NEXT_PUBLIC_SITE_URL=https://iconzbaznas.com

# --- Registrations -----------------------------------------------------------
# Where the registration form files what it collects: SIMBA, the committee's
# event register. Without SIMBA_URL, SIMBA_KEY, SIMBA_ORG and SIMBA_EVENT_ID
# the form still works in development and writes to the log instead — but a
# production build refuses the submission rather than thanking someone for a
# registration nobody received.
#
# SIMBA_KEY is a credential. Keep it out of the repository.
SIMBA_URL=https://demo-simba.baznas.or.id/api/ajax_event_register_peserta
SIMBA_KEY=
SIMBA_ORG=3171100
# 128 is "The 10th International Conference on Zakat". The 116 in the
# committee's example curl was a different, unrelated demo event.
SIMBA_EVENT_ID=128

# Event settings, not secrets.
#
# SIMBA_JENIS is the category the institution falls under, as free text — the
# committee's examples use "BAZNAS Kab/Kota" or "BAZNAS Provinsi" for a BAZNAS
# office and "Institusi" for a university or anything else. The form does not
# ask, so every registration carries this one value; most of them are
# universities and institutions, hence the default.
#
# There is no SIMBA_SPC_ID any more. spc_id has to be unique for every single
# registration — a repeat is refused as "Data exist" — so it is generated per
# submission and cannot be a setting.
SIMBA_JENIS=Institusi

# Emergency valve. Set to 1 only while SIMBA is refusing registrations.
#
# With it on, a registration SIMBA turns down is still written to the log and
# the registrant is thanked. Nothing is lost — the whole entry is in the log
# line beside the reason — but it is only in the log, so every one of them has
# to be entered into SIMBA by hand afterwards. Turn it off again the moment
# SIMBA is taking registrations, or the manual backlog grows silently.
REGISTRATION_ACCEPT_ON_REFUSAL=
