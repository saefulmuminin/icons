    {
      "name": "Site",
      "description": "The conference site's own endpoint.",
      "item": [
        {
          "name": "Register — valid",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// A fresh identity each run, so a refusal can never be blamed on",
                  "// duplicate data.",
                  "const n = Date.now().toString().slice(-8);",
                  "pm.collectionVariables.set('unique', n);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "console.log(body);",
                  "// 503 'refused' is SIMBA saying no; 503 'unconfigured' is a missing",
                  "// environment variable. They need opposite fixes.",
                  "pm.test('accepted', () => pm.expect(pm.response.code).to.eql(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"uji{{unique}}@example.com\",\n  \"prefix\": \"mrs\",\n  \"fullName\": \"Aisyah Putri\",\n  \"sex\": \"female\",\n  \"whatsapp\": \"0812{{unique}}\",\n  \"institution\": \"BAZNAS RI\",\n  \"continent\": \"asia\",\n  \"country\": \"ID\",\n  \"province\": \"dki-jakarta\",\n  \"city\": \"Jakarta Selatan\",\n  \"profession\": \"amil\",\n  \"professionOther\": \"\",\n  \"submittedPaper\": \"yes\",\n  \"seminarDays\": [\n    \"day-2\",\n    \"day-3\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{siteUrl}}/api/register",
              "host": [
                "{{siteUrl}}/api/register"
              ]
            },
            "description": "A complete Indonesian registration. 200 {ok:true} when SIMBA takes it; 503 {error:'refused'} when SIMBA turns it down; 503 {error:'unconfigured'} when the SIMBA environment variables are missing."
          }
        },
