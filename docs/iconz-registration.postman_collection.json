    {
      "name": "3 · The site",
      "description": "The conference site's own endpoint, which validates and then hands on.",
      "item": [
        {
          "name": "Register — Indonesian",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// spc_id has to be unique for every registration. A repeat is refused as",
                  "// \"Data exist or failed\" — the same sentence SIMBA uses for a bad key and",
                  "// for a missing column — which is why a fixed value looked for weeks like a",
                  "// broken endpoint. Fresh identity each run, so nothing can be blamed on it.",
                  "const n = Date.now().toString().slice(-7);",
                  "pm.collectionVariables.set('unique', n);",
                  "pm.collectionVariables.set('spcId', String(Math.floor(Math.random() * 2000000000) + 1));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "console.log(pm.response.json());",
                  "pm.test('accepted', () => pm.expect(pm.response.code).to.eql(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"uji{{unique}}@example.com\",\n  \"prefix\": \"mrs\",\n  \"fullName\": \"Aisyah Putri\",\n  \"sex\": \"female\",\n  \"dialCode\": \"+62\",\n  \"whatsapp\": \"8120000{{unique}}\",\n  \"institution\": \"BAZNAS Provinsi Jawa Barat\",\n  \"institutionKind\": \"baznas-provinsi\",\n  \"continent\": \"asia\",\n  \"country\": \"ID\",\n  \"province\": \"jawa-barat\",\n  \"city\": \"Bandung\",\n  \"profession\": \"amil\",\n  \"professionOther\": \"\",\n  \"submittedPaper\": \"yes\",\n  \"seminarDays\": [\n    \"day-2\",\n    \"day-3\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{siteUrl}}/api/register",
              "host": [
                "{{siteUrl}}/api/register"
              ]
            },
            "description": "200 {ok:true} when SIMBA takes it. 503 {error:'refused'} when SIMBA turns it down — the reason goes to the server log. 503 {error:'unconfigured'} when no key is set in the code."
          }
        },
