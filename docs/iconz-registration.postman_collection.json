    {
      "name": "1 · Production",
      "description": "simba.baznas.go.id, event 202. The one that has to work.",
      "item": [
        {
          "name": "Register a participant",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// spc_id has to be unique for every registration. A repeat is refused as",
                  "// \"Data exist or failed\" — the same sentence SIMBA uses for a bad key and",
                  "// for a missing column — which is why a fixed value looked for weeks like a",
                  "// broken endpoint. Fresh identity each run, so nothing can be blamed on it.",
                  "const n = Date.now().toString().slice(-7);",
                  "pm.collectionVariables.set('unique', n);",
                  "pm.collectionVariables.set('spcId', String(Math.floor(Math.random() * 2000000000) + 1));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// SIMBA answers HTTP 200 to everything, refusals included. The verdict is",
                  "// in status_code, so that is what is asserted. A green tick in Postman's",
                  "// status column means nothing on its own.",
                  "const body = pm.response.json();",
                  "console.log(body);",
                  "pm.test('SIMBA accepted it (status_code 000)', function () {",
                  "    pm.expect(String(body.status_code)).to.be.oneOf(['000', '100', '200']);",
                  "});"
                ]
              }
            }
          ],
