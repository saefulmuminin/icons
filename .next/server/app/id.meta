{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/[lang]/layout,_N_T_/[lang]/page,_N_T_/id"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/$d$lang",
    "/$d$lang/__PAGE__"
  ],
  "prefetchHints": {
    "hints": 64,
    "slots": {
      "children": {
        "hints": 32,
        "slots": {
          "children": {
            "hints": 128,
            "slots": null
          }
        }
      }
    }
  }
}